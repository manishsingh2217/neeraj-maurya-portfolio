{
  "name": "neeraj-maurya-portfolio",
  "version": "1.0.0",
  "description": "Full-Stack Dynamic Portfolio and Admin CMS for Neeraj Maurya",
  "main": "server/index.js",
  "scripts": {
    "build": "npm --prefix client install --include=dev && npm --prefix client run build && npm --prefix server install",
    "start": "node server/index.js",
    "server": "npm --prefix server start",
    "client": "npm --prefix client run dev"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.4",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.6.1"
  },
  "keywords": ["portfolio", "react", "express", "nodejs", "tailwind", "cms"],
  "author": "Neeraj Maurya",
  "license": "MIT"
}
